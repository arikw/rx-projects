---
import BaseHead from '../components/BaseHead.astro';
// Theme parts resolve to src/themes/<ui.theme>/<file>, falling back to
// src/themes/default/<file> (see the theme resolver in astro.config.mjs).
import ThemeHead from 'theme:Head.astro';
import ThemeHeader from 'theme:Header.astro';
import ThemeFooter from 'theme:Footer.astro';
import '../themes/default/theme.css';
import '../styles/global.css';
import 'theme:theme.css';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  author?: string;
  /** Forwarded to BaseHead — see that component for og:image semantics. */
  image?: string;
  imageAlt?: string;
}

const { title, description, ogType, author, image, imageAlt } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} ogType={ogType} author={author} image={image} imageAlt={imageAlt} />
    <ThemeHead />
  </head>
  <body>
    <script>
      document.addEventListener('click', (e) => {
        if (!(e.target instanceof Element)) return;
        if (e.target.closest('.stat-delta')) {
          e.preventDefault();
          e.stopPropagation();
        }
      }, true);
    </script>
    <ThemeHeader />
    <div class="page">
      <main class="site-main">
        <slot />
      </main>
    </div>
    <ThemeFooter />
  </body>
</html>
