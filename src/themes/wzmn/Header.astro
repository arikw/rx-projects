---
// The screen-lit top bar: where you are, in the computer's own words.
// A:\WZMN goes home to the Amstrad; \PROJECTS to the list. On a project's
// page the last part is its name as a DOS 8.3 file name (POPER-~1), which
// isn't a link. Blog and Contact live outside this site.
const base = import.meta.env.BASE_URL;
// The site's own pages by path, so the bar works on any deployment of the
// site (wzmn.net, or a Cloudflare preview).
const home = '/';
const rest = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length).replace(/\/$/, '')
  : '';

// "poper-blocker" → "POPER-~1", as DOS 3.x would show a long name.
function dosName(slug: string): string {
  const name = slug.toUpperCase().replace(/[^A-Z0-9-]/g, '');
  return name.length <= 8 ? name : `${name.slice(0, 6)}~1`;
}
---

<header class="wz-top">
  <div class="wz-bar">
    {/* One line on purpose: any whitespace between the parts shows as a gap. */}
    <div class="wz-path"><a href={home} title="Home: the Amstrad">A:\WZMN</a>{rest ? <><a href={base} title="All projects">\PROJECTS</a><span>\{dosName(rest)}</span></> : <span>\PROJECTS</span>}&gt;<span class="wz-caret" aria-hidden="true"></span></div>
    <nav class="wz-nav" aria-label="Main">
      <a href={home}>Home</a>
      <a href={base} aria-current={rest ? 'location' : 'page'}>Projects</a>
      <a href="/blog/">Blog</a>
      <a href="/contact/">Contact</a>
    </nav>
  </div>
</header>

{/* The change indicators' toggle: the template's delta-toggle script (on the
    main page) shows it when something changed since the last visit, and
    hides or shows the markers on click. share.ts moves it next to Share and
    writes the count on it. Hidden until then. */}
<button type="button" class="wz-eye" data-delta-toggle data-tooltip="" aria-label="Show or hide what changed since your last visit" hidden>
  <svg class="delta-toggle-eye-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5C7 5 2.7 8.1 1 12.5 2.7 17 7 20 12 20s9.3-3 11-7.5C21.3 8.1 17 5 12 5zm0 12.5a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-2.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z" /></svg>
  <svg class="delta-toggle-eye-shut" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5C7 5 2.7 8.1 1 12.5c.84 2.2 2.3 4.05 4.16 5.4l-2.3 2.3 1.4 1.4 17-17-1.4-1.4-3.05 3.05A11.4 11.4 0 0 0 12 5zm0 3a4.5 4.5 0 0 1 4.5 4.5c0 .59-.12 1.16-.32 1.68l-5.86-5.86c.53-.2 1.1-.32 1.68-.32zM4.5 12.5A9.4 9.4 0 0 1 12 8c.46 0 .9.04 1.34.12L11.5 9.96A2.5 2.5 0 0 0 9.96 11.5L7.6 13.86A7.4 7.4 0 0 1 4.5 12.5zM12 20a11.4 11.4 0 0 1-3.34-.5l1.66-1.66c.55.1 1.12.16 1.68.16a9.4 9.4 0 0 0 7.5-3.74l-2.2-2.2c.2-.51.32-1.07.32-1.66 0-.56-.06-1.13-.16-1.68l1.66-1.66a11.4 11.4 0 0 1 3.34 3.34C21.3 16.9 17 20 12 20z" /></svg>
  <span class="n"></span><span>changes</span>
</button>

<script>
  // The opening starts when the page is actually shown: now, or, for a page
  // built ahead in the background (prerender), when it's switched to.
  const root = document.documentElement;
  // The computer is the site's home page (/), or one of its drafts.
  function fromComputer() {
    try {
      const ref = new URL(document.referrer);
      return ref.origin === location.origin && (ref.pathname === '/' || ref.pathname.startsWith('/drafts/crt'));
    } catch (e) {
      return false;
    }
  }
  function arrive() {
    try {
      if (sessionStorage.getItem('wzmn-from-crt')) root.classList.add('from-crt');
      else if (!fromComputer()) root.classList.remove('from-crt');
      sessionStorage.removeItem('wzmn-from-crt');
      sessionStorage.removeItem('wzmn-dark');
    } catch (e) {}
    root.classList.add('wz-arrive');
  }
  const doc = document as Document & { prerendering?: boolean };
  if (doc.prerendering) document.addEventListener('prerenderingchange', arrive, { once: true });
  else arrive();
</script>
